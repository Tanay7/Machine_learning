### Cell 2: Define Helper Functions

*Run this to load the Database connection logic and the High-Speed Copy function into memory.*

```python
def get_connection():
    """Establishes a connection to the database."""
    config = configparser.ConfigParser()
    config.read('PSQL_config_file.ini')
    s = config['connection_settings']
    
    conn = psycopg2.connect(
        dbname=s['database'],
        user=s['username'],
        password=s['password'],
        host=s['hostname'],
        sslmode='require',
        connect_timeout=10
    )
    conn.autocommit = True 
    return conn, s['schema']

def bulk_copy_data(cursor, data_generator, schema, table_name):
    """
    Streams data using an in-memory text buffer and Postgres COPY protocol.
    """
    buffer = io.StringIO()
    count = 0
    batch_count = 0
    
    for row in data_generator:
        # Write tab-separated row to buffer
        buffer.write(f"{row[0]}\t{row[1]}\t{row[2]}\n")
        count += 1
        
        # Flush buffer every 5MB
        if buffer.tell() > 1024 * 1024 * 5: 
            buffer.seek(0)
            cursor.copy_expert(f"COPY {schema}.{table_name} (cust_id, cluster_id, cluster_score) FROM STDIN", buffer)
            buffer.truncate(0)
            buffer.seek(0)
            batch_count += 1
            if batch_count % 5 == 0:
                print(f"   ... Streamed {count} rows so far ...")

    # Flush remaining
    if buffer.tell() > 0:
        buffer.seek(0)
        cursor.copy_expert(f"COPY {schema}.{table_name} (cust_id, cluster_id, cluster_score) FROM STDIN", buffer)

    return count

print("Functions defined.")
```

### Cell 3: Connect and Load Data

*Run this to fetch data from Postgres and load it into RAM. Watch the output for the record count.*

```python
conn, schema = get_connection()
c = conn.cursor()

logger.info(f'Importing data from {INPUT_TABLE}...')

query = f"""
    SELECT id, name_only, gender, dob, address, occupation, bank_acct_no 
    FROM {schema}.{INPUT_TABLE}
"""
c.execute(query)

columns = ['id', 'name_only', 'gender', 'dob', 'address', 'occupation', 'bank_acct_no']
data_d = {}

# Dictionary comprehension for fast cleaning
for row in c:
    row_dict = dict(zip(columns, row))
    # Convert None to empty string
    clean_row = {k: (v if v is not None else '') for k, v in row_dict.items()}
    data_d[clean_row['id']] = clean_row

logger.info(f'Success: {len(data_d)} records loaded into memory.')
```

